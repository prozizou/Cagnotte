# Configuration Firebase (Console Firebase → Paramètres du projet → Vos applications → Config)
# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Cloudinary (Dashboard Cloudinary → Programmable Media → API Keys)
# images de couverture des cagnottes. SANS préfixe NEXT_PUBLIC_ : utilisées
# uniquement côté serveur (route /api/upload-image), jamais dans le navigateur.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
