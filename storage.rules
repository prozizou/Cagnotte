// ============================================================================
// Règles de sécurité Firebase Storage — Cotiz
//
// Utilisé uniquement pour les images de couverture des cagnottes
// (cagnottes/{ownerId}/{fichier}). Le chemin porte directement l'ownerId :
// contrairement à Realtime Database, ces règles ne peuvent pas interroger
// la base pour vérifier qui est réellement propriétaire d'une cagnotte —
// le segment {ownerId} du chemin fait donc foi, et seul ce propriétaire
// (ou le Super Admin, identifié par son email comme dans
// database.rules.json) peut y écrire.
//
// Lecture publique et volontaire : ces images sont conçues pour être
// partagées (WhatsApp, réseaux sociaux), qui les récupèrent sans être
// authentifiés.
// ============================================================================
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /cagnottes/{ownerId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.email == 'prozizou298@gmail.com')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.email == 'prozizou298@gmail.com');
    }

    // Tout le reste est refusé par défaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
